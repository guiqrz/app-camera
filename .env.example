# Modelo de configuracao. Copie para .env.local e preencha.
#   Windows (PowerShell):  Copy-Item .env.example .env.local
#
# .env.local NUNCA vai para o Git (ver .gitignore). Nao coloque a chave real
# neste arquivo de exemplo.

# Endereco da API do CUPCAM.
#   Desenvolvimento local:  http://127.0.0.1:8000
#   Com o tunel ligado:     a URL https://....trycloudflare.com que o
#                           cloudflared imprime no terminal
CUPCAM_API_URL=http://127.0.0.1:8000

# Chave exigida pela API no header X-API-Key.
# Precisa ser IGUAL a do backend (variavel CUPCAM_API_KEY no notebook). O valor
# abaixo e' o de DESENVOLVIMENTO, que so' funciona com a API rodando local.
#
# Ao expor pela internet: gere uma chave secreta uma vez e defina nos DOIS
# lados — aqui (ou nas Environment Variables da Vercel) e no notebook. O
# backend se recusa a subir exposto com a chave de desenvolvimento.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Esta variavel e' lida SO' no servidor (sem prefixo NEXT_PUBLIC_), entao ela
# nunca chega ao navegador. Nao renomeie pra NEXT_PUBLIC_*: isso publicaria a
# chave da API no bundle que qualquer visitante baixa.
CUPCAM_API_KEY=cupcam-dev-trocar-no-dia

# Sala onde esta camera esta instalada — o MESMO valor de SALA_ID em
# cupcam/config.py, no backend. Usado so' pela tela de Configuracoes, pra
# mostrar a sala e avisar quantas aulas o modo automatico alcanca.
# Opcional: sem ela, a tela nao mostra esses dois itens.
CUPCAM_SALA_ID=sala_32A

# --- Deploy na Vercel -------------------------------------------------------
# Estas mesmas variaveis vao em Settings > Environment Variables no projeto da
# Vercel (nao commitadas em lugar nenhum):
#
#   CUPCAM_API_URL   a URL publica do tunel do notebook
#   CUPCAM_API_KEY   a chave secreta, IGUAL a do backend
#   CUPCAM_SALA_ID   a sala da camera
#
# E no notebook, antes de subir a API:
#   $env:CUPCAM_API_KEY = "<a mesma chave>"
#   $env:CUPCAM_EXPOSTA = "1"
#   $env:CUPCAM_ORIGENS_PERMITIDAS = "https://<seu-app>.vercel.app"
